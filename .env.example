# Copy to .env.local (gitignored) and fill in.
#
# The token is Second Brain's `secret_agui_token`, set via /config in the REPL.
# It also lives in DATA_DIR/plugin_config.json.
#
# Vite only exposes variables prefixed VITE_ to the browser. That prefix is a
# reminder rather than a protection: anything here is compiled into the bundle
# and readable by anyone who can open the page.
VITE_AGUI_URL=http://127.0.0.1:8787
VITE_AGUI_TOKEN=
