# Development only: copy to .env.local (gitignored) and fill in. Production
# reads its backend token from the private Caddy runtime.env instead.

# Where Second Brain is. **Used by the dev server's proxy, not by the browser.**
# The app always talks to its own origin — `vite.config.ts` forwards /sdk and
# /events here — so CORS never comes into it. Production uses the same paths
# through its loopback Caddy gateway.
#
# That is worth knowing if you ever do point a browser straight at the server:
# `http_allowed_origins` is echoed into `Access-Control-Allow-Origin` verbatim,
# so it must match the Origin header exactly — no trailing slash, and
# `localhost` and `127.0.0.1` are different origins.
VITE_SB_URL=http://127.0.0.1:8787

# Second Brain's `secret_http_token`, set via /config in the REPL. Development
# only: Vite uses it while proxying to the loopback server.
#
# Production builds deliberately ignore this value. Caddy reads the token from
# its private runtime.env and adds it only on the loopback request to Second
# Brain, so no production browser bundle contains the credential.
VITE_SB_TOKEN=

# Which session this browser talks to. `?thread=main` keys the session
# `http:main`; two threads are two independent conversations. Leave it alone
# unless you want a second, isolated client against the same server.
VITE_SB_THREAD=main
